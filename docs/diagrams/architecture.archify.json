 "cards": [
  {
   "dot": "cyan",
   "title": "The model proposes",
   "items": [
    "glm-5.3 writes the plan and the edits through declared tools",
    "An approved plan compiles into an allowlist: exact commands, files, digest-pinned images",
    "Raw build errors go back to the model, 3 attempts at most"
   ]
  },
  {
   "dot": "rose",
   "title": "Blast radius zero",
   "items": [
    "Every build and test runs in a fresh microVM, never on the host",
    "Egress denied: only a recording DNS resolver and a documentation-range sinkhole answer",
    "Each microVM is destroyed and its destruction time is recorded"
   ]
  },
  {
   "dot": "emerald",
   "title": "The probe decides",
   "items": [
    "Positive and negative controls must pass before any server is judged",
    "Hybrid-only client must negotiate X25519MLKEM768; a classical client must still connect",
    "Everything lands in a hashed receipt anyone can verify again"
   ]
  }
 ]
